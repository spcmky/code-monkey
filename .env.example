# AWS Configuration
AWS_REGION=us-east-2
AWS_PROFILE=default

# GitHub
GITHUB_PAT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:000000000000:secret:your-secret-name

# Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_monkey
DB_USER=code_monkey
DB_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
DB_SSL=false
DB_CA_CERT=

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD

# AWS endpoint override (LocalStack only — leave blank for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566

# SQS Queues
SQS_TASK_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/000000000000/code-monkey-tasks
SQS_RESULT_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/000000000000/code-monkey-results

# SNS Topics
SNS_ESCALATION_TOPIC_ARN=arn:aws:sns:us-east-2:000000000000:code-monkey-notifications

# Bedrock
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Agent Configuration
POLL_INTERVAL_CRON=*/5 * * * *
WATCHED_REPOS=owner/repo
WORK_DIR=/tmp/code-monkey-workspaces

# Logging
LOG_LEVEL=info
